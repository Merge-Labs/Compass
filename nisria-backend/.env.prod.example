# Example production environment file
# Copy to .env.prod and fill values before deploying

DJANGO_ENV=production
SECRET_KEY=replace-this-with-a-secure-secret
DEBUG=False

DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=nisria
DATABASE_USER=nisria
DATABASE_PASSWORD=nisria


# Allowed hosts - comma-separated (example: example.com,www.example.com)
ALLOWED_HOSTS=localhost

# Gunicorn workers
GUNICORN_WORKERS=4

# Redis (if used by Celery)
REDIS_URL=redis://redis:6379/0
