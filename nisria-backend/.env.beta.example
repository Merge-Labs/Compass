# Beta/Testing Environment Variables
# Copy this file to .env.beta and fill in the values

# =============================================================================
# DJANGO SETTINGS
# =============================================================================
DJANGO_ENV=production
DEBUG=False

# Generate a unique secret key for beta environment
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-beta-secret-key-here

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
# Option 1: Use DATABASE_URL (recommended for Coolify)
DATABASE_URL=postgres://nisria:your-password@db:5432/nisria_beta

# Option 2: Use individual variables (if not using DATABASE_URL)
# DATABASE_HOST=db
# DATABASE_PORT=5432
# DATABASE_NAME=nisria_beta
# DATABASE_USER=nisria
# DATABASE_PASSWORD=your-password

# =============================================================================
# REDIS SETTINGS
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# HOSTS & CORS SETTINGS
# =============================================================================
# Comma-separated list of allowed hosts
ALLOWED_HOSTS=api-beta.yourdomain.com,localhost

# Comma-separated list of allowed CORS origins (include frontend domains)
CORS_ALLOWED_ORIGINS=https://beta.yourdomain.com,http://localhost:5173,http://localhost:3000

# =============================================================================
# CLOUDINARY SETTINGS
# =============================================================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# =============================================================================
# GUNICORN SETTINGS
# =============================================================================
# Number of Gunicorn workers (2 is good for beta/testing)
GUNICORN_WORKERS=2

# Set to 1 to skip collectstatic (useful for debugging)
SKIP_COLLECTSTATIC=0
